{
  "$schema": "https://opencode.ai/config.json",
  "username": "edk2-developer",
  "model": "opencode/zen",
  "small_model": "opencode/zen",
  "default_agent": "general",
  "logLevel": "INFO",
  "share": "disabled",
  "autoupdate": "notify",
  "snapshot": true,
  
  "skills": {
    "paths": [
      ".opencode/skills"
    ]
  },
  
  "mcp": {},
  
  "permission": {
    "edit": "ask",
    "bash": { "git *": "allow", "*": "ask" },
    "external_directory": { ".": "allow", "*": "ask" }
  },
  
  "instructions": [
    "AGENTS.md"
  ],
  
  "experimental": {
    "primary_tools": ["edit", "bash", "glob", "grep", "read"],
    "mcp_timeout": 60000
  }
}