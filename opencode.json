{
  "$schema": "https://opencode.ai/config.json",
  "username": "edk2-developer",
  "model": "anthropic/claude-sonnet-4-6",
  "small_model": "anthropic/claude-3-5-haiku-latest",
  "default_agent": "general",
  "logLevel": "INFO",
  "share": "disabled",
  "autoupdate": "notify",
  "snapshot": true,
  
  "skills": {
    "paths": [
      ".opencode/skills"
    ]
  },
  
  "mcp": {
    "edk2-rag": {
      "type": "http",
      "url": "http://192.168.122.116:8080",
      "enabled": true
    }
  },
  
  "plugin": [
    "./.opencode/plugins/edk2-auth-guard.ts",
    "./.opencode/plugins/edk2-api-provider.ts"
  ],
  
  "permission": {
    "edit": "ask",
    "bash": { "git *": "allow", "*": "ask" },
    "external_directory": { ".": "allow", "*": "ask" }
  },
  
  "instructions": [
    "AGENTS.md"
  ],
  
  "experimental": {
    "primary_tools": ["edit", "bash", "glob", "grep", "read"],
    "mcp_timeout": 60000
  }
}