# Local (offline) LLM config for the Web Q&A — Ollama, OpenAI-compatible.
# To use it, copy this over .env:
#   Copy-Item D:\edk2Agent\web\.env.ollama D:\edk2Agent\web\.env -Force
# Prereq: D:\tools\Ollama\ollama.exe serve  (model qwen2.5:14b pulled)
LLM_API_KEY=ollama
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen2.5:14b

JUDGE_MODEL=qwen2.5:14b
LLM_REASONING_EFFORT=none
