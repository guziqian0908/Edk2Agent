# Edk2Agent Web Q&A — LLM configuration (OpenAI-compatible)
# Copy this file to .env and fill in your values.
# Loaded automatically by server.js at startup. Never commit .env itself.

# Required: LLM API Key (leave empty to only show search results without LLM answer)
LLM_API_KEY=

# Required: OpenAI-compatible API endpoint
# Examples:
#   DeepSeek:   https://api.deepseek.com
#   智谱 GLM:   https://open.bigmodel.cn/api/paas/v4
#   OpenAI:     https://api.openai.com/v1
LLM_BASE_URL=

# Required: Model name matching your endpoint
# Examples: deepseek-v4-flash, glm-4-flash, gpt-4o-mini
LLM_MODEL=

# Optional: Answer depth (per-tier token limits)
# LLM_MAX_TOKENS_SIMPLE=1600     # simple tier (short questions)
# LLM_MAX_TOKENS=3000            # standard tier (default)
# LLM_MAX_TOKENS_COMPLEX=6000    # complex tier (multi-part questions)

# Optional: Context budget for complex queries
# LLM_CTX_CHARS_COMPLEX=16000    # chars of retrieval context for complex questions

# Optional: Reasoning effort for query decomposition
# LLM_REASONING_EFFORT=none      # none/low/medium

# Optional: Judge model for eval (stronger model = less variance)
# JUDGE_MODEL=deepseek-chat

# Optional: Rerank tuning
# RERANK_CANDIDATES_COMPLEX=24
# RERANK_SNIPPET_CHARS_COMPLEX=1200

# Optional: Faithfulness check toggles
# L3_FAITHFULNESS_CHECK=true     # set false to disable L3 judge
# L3_REVISION=true               # set false to disable C' critic-revise
